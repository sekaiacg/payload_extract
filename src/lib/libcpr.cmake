# cpr
execute_process(COMMAND readlink -f "${CMAKE_CURRENT_SOURCE_DIR}/cpr/CMakeLists.txt" OUTPUT_VARIABLE PATH_TARGET_FILE)
string(REGEX REPLACE "\n$" "" PATH_TARGET_FILE "${PATH_TARGET_FILE}")
execute_process(COMMAND patch -N -s --no-backup-if-mismatch -r "/dev/null"
    "${PATH_TARGET_FILE}"
    "${CMAKE_CURRENT_SOURCE_DIR}/patch/libcpr_CMakeLists.patch"
)
set(BUILD_CURL_EXE OFF)
set(BUILD_SHARED_LIBS OFF)
set(BUILD_STATIC_LIBS ON)
set(BUILD_LIBCURL_DOCS OFF)
set(CPR_BUILD_TESTS OFF)
set(CURL_BROTLI OFF CACHE STRING "")
set(CURL_ZLIB OFF CACHE STRING "")
set(CURL_ZSTD OFF CACHE STRING "")
set(CURL_USE_LIBPSL OFF)
set(CURL_USE_LIBSSH2 OFF)
SET(CURL_USE_OPENSSL OFF)
set(CPR_CURL_USE_LIBPSL OFF)
set(HAVE_ZSTD 0)
set(HAVE_ZLIB 0)
set(USE_LIBIDN2 OFF)
set(USE_NGHTTP2 OFF)
set(BUILD_EXAMPLES OFF)
set(BUILD_TESTING OFF)
if (CMAKE_SYSTEM_NAME MATCHES "Linux|Android")
    set(CPR_FORCE_WOLFSSL_BACKEND ON)
elseif (CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(CPR_FORCE_DARWINSSL_BACKEND ON)
elseif (CMAKE_SYSTEM_NAME STREQUAL "Windows")
    set(CPR_FORCE_WINSSL_BACKEND ON)
endif ()
add_subdirectory("cpr")
